      "enabled": true,
      "environment": {
        "DATAFORSEO_USERNAME": "arsatmac@gmail.com",
        "DATAFORSEO_PASSWORD": "e7fb1851e4352c18",
        "ENABLED_MODULES": "SERP,KEYWORDS_DATA,DATAFORSEO_LABS,BACKLINKS"
      }
    }
},
  "provider": {
